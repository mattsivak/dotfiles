yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config layout bsp
yabai -m config window_placement second_child

yabai -m config top_padding    10
yabai -m config bottom_padding 10
yabai -m config left_padding   10 
yabai -m config right_padding  10
yabai -m config window_gap     10
yabai -m config external_bar   all:46:0 

yabai -m config auto_balance on

# set mouse interaction modifier key (default: fn)
yabai -m config mouse_modifier alt

# set modifier + left-click drag to move window (default: move)
#yabai -m config mouse_action1 move

# set modifier + right-click drag to resize window (default: resize)
#yabai -m config mouse_action2 resize

# yabai -m config focus_follows_mouse autoraise
yabai -m config mouse_follows_focus on


yabai -m config window_opacity off
yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 1.0

# yabai -m config menubar_opacity 1.0

# NOTCH_UUID="37D8832A-2D66-02CA-B9F7-8F30A301B230"
# NORMAL_BAR=10
# NOTCH_BAR=10

# Detect internal display (MacBook screen) by UUID or dimensions
INTERNAL_DISPLAY=$(yabai -m query --displays | jq '.[] | select(.uuid == "37D8832A-2D66-02CA-B9F7-8F30A301B230") | .index')

# NOTE: a notch-aware external_bar conditional used to live here. It referenced
# $NOTCH_UUID / $NORMAL_BAR / $NOTCH_BAR, all commented out above, so it always
# evaluated to `external_bar main::0` and silently clobbered line 12 on every
# yabai start. external_bar is now set once, unconditionally, at line 12.

yabai -m rule --add app="^System Preferences$" manage=off
yabai -m rule --add app="^Digital Colou?r Meter$" sticky=on

#yabai -m config window_animation_duration 0.20
#yabai -m config window_animation_easing easeInOutCirc

yabai -m config window_shadow off

yabai -m signal --add event=window_created action="sketchybar -m --trigger window_change &> /dev/null"
yabai -m signal --add event=window_destroyed action="sketchybar -m --trigger window_change &> /dev/null"

# The bar's pill shape depends on which display is the built-in one and how
# many displays exist, and that is decided when sketchybarrc runs. Plugging or
# unplugging a monitor renumbers the displays, so the bar has to re-read its
# config or the pills stay associated with displays that moved.
yabai -m signal --add event=display_added action="sketchybar --reload &> /dev/null"
yabai -m signal --add event=display_removed action="sketchybar --reload &> /dev/null"

# Desktop icons appear only while the visible space on the main display is
# empty. Every event that can change "is this space empty" has to re-evaluate:
# windows arriving and leaving, minimise/deminimise (a minimised window covers
# nothing), moving a window between spaces or displays, and switching space.
#
# display_added/removed are included because the main display itself can
# change when monitors come and go.
DESKTOP_ICONS="$HOME/.scripts/desktop_icons_auto.sh"
for ev in window_created window_destroyed window_minimized window_deminimized \
          window_moved space_changed display_added display_removed system_woke; do
  yabai -m signal --add event="$ev" action="$DESKTOP_ICONS &> /dev/null"
done
#yabai -m signal --add event=window_focused action="yabai -m config window_opacity on"
